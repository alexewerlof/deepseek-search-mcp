{
    "name": "deepseek-search-mcp",
    "version": "0.1.0",
    "private": true,
    "description": "MCP server exposing the DeepSeek Search and Fetch APIs to a remote LM Studio over Streamable HTTP",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "start": "node --env-file-if-exists=.env src/main.ts",
        "fmt": "prettier --write .",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test:unit": "node --test \"test/unit/**/*.test.ts\"",
        "test:live": "node --env-file-if-exists=.env --test test/live/checks.ts"
    },
    "keywords": [
        "mcp",
        "deepseek",
        "search",
        "lm-studio"
    ],
    "license": "MIT",
    "dependencies": {
        "@modelcontextprotocol/express": "^2.0.2",
        "@modelcontextprotocol/node": "^2.1.2",
        "@modelcontextprotocol/server": "^2.4.0",
        "express": "^5.3.0",
        "zod": "^4.2.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@modelcontextprotocol/client": "^2.4.0",
        "@types/express": "^5",
        "@types/node": "^24",
        "eslint": "^10.13.0",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1"
    }
}
