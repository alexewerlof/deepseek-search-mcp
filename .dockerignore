# Never bake configuration into an image layer: `podman history` and `save` would
# expose it forever. Configuration arrives at run time instead.
.env
.env.*

node_modules
test
.agents

# Not part of the runtime image: the CI definition is read from the repo, and
# `deploy/` is documentation for the host machine.
.github
deploy

