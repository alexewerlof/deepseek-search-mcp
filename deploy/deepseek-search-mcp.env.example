# Template for the file the Quadlet unit reads. Copy it to
# `~/.config/deepseek-search-mcp/env`, `chmod 600`, and fill in the values.
#
# This file is the ONLY place a real credential belongs. It is never committed,
# never copied into the image, and never passed to `docker build` or CI. Keep it
# to plain KEY=value lines: Podman's EnvironmentFile parser does not handle
# comments at the end of a line, quotes, or `export`.
#
# This is the engine's environment-file format, unrelated to Node's
# `--env-file`; the two parsers differ, and this subset reads the same in both.

# Pays for DeepSeek Search and Fetch calls. Never leaves this machine.
DEEPSEEK_API_KEY=

# Proves the MCP host is allowed to call this server. The same value goes in the
# host's config (`mcp.json` or Jan's settings). Generate with:
#   openssl rand -hex 32
MCP_AUTH_TOKEN=

# Accept calls from any Chrome extension origin. Replace with the exact id
# (`chrome-extension://<id>`) once the extension is packed. The Origin guard is
# always on, because the MCP specification requires it; non-browser clients send
# no Origin header and pass.
MCP_ALLOWED_ORIGINS=chrome-extension://*

# Optional. `Host` names (port agnostic) clients dial. Setting this rejects a
# rebound Host header on top of the bearer token; leaving it out installs no
# Host guard, and the startup line says so. `*` opts out explicitly.
# Replace the documentation values below with the real ones; they are RFC 5737
# and RFC 2606 ranges, which never reach a real machine.
# MCP_ALLOWED_HOSTS=198.51.100.10,server.example,localhost

# Optional. Defaults are fine for a local model; lower them further if the
# context window is small.
# DEEPSEEK_SEARCH_MAX_RESULTS=5
# DEEPSEEK_SEARCH_CONTENT_CHARS=2000
# DEEPSEEK_SEARCH_TEXT_CHARS=12000
# DEEPSEEK_FETCH_MAX_CHARS=20000

# `off`, `info` (default) or `debug`. Logs go to the journal and never include
# the token or a request body.
# MCP_LOG_LEVEL=info
