# DeepSeek API key used to pay for Search and Fetch calls.
# Required. Copy this file to `.env` and fill it in; never commit the real value.
# `npm start` loads it with Node's --env-file-if-exists, so the file is optional:
# a container's -e flags or a host's config work just as well. Node treats `#` as
# the start of a comment anywhere in a line (quote such a value) and does not
# expand `$VAR`.
DEEPSEEK_API_KEY=

# Optional DeepSeek overrides.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=30000
DEEPSEEK_MAX_RETRIES=2

# Output caps. These keep tool results small enough for a local model context.
DEEPSEEK_SEARCH_MAX_RESULTS=5
DEEPSEEK_SEARCH_CONTENT_CHARS=2000
DEEPSEEK_SEARCH_TEXT_CHARS=12000
DEEPSEEK_FETCH_MAX_CHARS=20000

# HTTP server binding. Use 127.0.0.1 for same-machine use, or 0.0.0.0 when
# the client (e.g. LM Studio) runs on another machine.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8765
MCP_HTTP_PATH=/mcp

# The client must send a Bearer token in the Authorization header.
# Required whenever the server is reachable from another machine.
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional. Hostnames (port agnostic) this server answers for, so a rebound
# Host header is rejected in addition to the bearer token check. Leave it unset
# and the startup line reports `host check off`; set it to `*` to say that on
# purpose. Example: 198.51.100.10,server.example
MCP_ALLOWED_HOSTS=

# Always enforced, as the MCP specification requires. MCP clients do not send an
# Origin header, so this only affects browser based clients.
# Entries are hostnames, not origins: `server.example`, not https://server.example.
# A Chrome extension sends chrome-extension://<extension-id>, so list its id or
# chrome-extension://* for every extension. Setting this replaces the loopback
# defaults (localhost,127.0.0.1,[::1]) — include them if a local page calls this
# server too. A rejected Origin is a 403. An entry that could never match (`*`,
# `https://*`, a full URL) refuses to start instead of silently rejecting clients.
MCP_ALLOWED_ORIGINS=

# Request logging on stderr: off, info (one summary line per request) or debug
# (also prints the headers a client sent). Logs never include the token or a
# request body. Rejected requests name the guard that blocked them and the
# setting that fixes it. Unknown values refuse to start.
MCP_LOG_LEVEL=info
